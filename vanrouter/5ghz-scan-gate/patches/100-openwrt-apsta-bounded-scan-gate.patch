+		gate.phase = "parked";
+		gate.retry = uloop.timer(gate.retry_ms, () => {
+			delete gate.retry;
+			if (!scan_gate_valid(ifname, iface, gate) || gate.phase != "parked")
+				return;
+
+			wpas.printf(`AP/STA scan gate retrying ${ifname}`);
+			if (!scan_gate_begin_window(ifname, iface, gate))
+				return;
