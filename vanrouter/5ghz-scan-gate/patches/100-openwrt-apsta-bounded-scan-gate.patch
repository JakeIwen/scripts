+	gate.disconnect_attempts++;
+	gate.disconnect_ok = iface.ctrl("DISCONNECT") == "OK";
+	gate.settle = uloop.timer(scan_gate_settle_ms, () => {
+		delete gate.settle;
+		if (!scan_gate_valid(ifname, iface, gate))
+			return;
+
+		let state = scan_gate_state(iface);
+		if (state == "COMPLETED") {
+			scan_gate_connected(ifname, iface, gate);
+			return;
+		}
