+		delete gate.grace;
+		if (!scan_gate_valid(ifname, iface, gate) || gate.phase != "connecting")
+			return;
+
+		let state = scan_gate_state(iface);
+		if (state == "COMPLETED") {
+			scan_gate_connected(ifname, iface, gate);
+			return;
+		}
+		if (scan_gate_is_associating(state)) {
+			gate.association_started = true;
+			return;
+		}
+
+		scan_gate_park(ifname, iface, gate, reason);
+	});
+}
+
+function scan_gate_handle_ctrl_event(ifname, iface, ev)
+{
+	let gate = scan_gate_get(ifname, iface);
+	if (!gate || gate.phase == "fault")
+		return;
+
+	if (match(ev, /^CTRL-EVENT-SCAN-STARTED/)) {
+		if (gate.phase == "parked" || gate.phase == "idle")
+			scan_gate_begin_window(ifname, iface, gate);
+		return;
+	}
+
+	if (gate.phase != "connecting")
+		return;
+
+	if (match(ev, /^CTRL-EVENT-SCAN-RESULTS/))
+		scan_gate_defer_park(ifname, iface, gate, "scan completed without association",
+			scan_gate_result_grace_ms);
+	else if (match(ev, /^CTRL-EVENT-(NETWORK-NOT-FOUND|SCAN-FAILED)/))
+		scan_gate_defer_park(ifname, iface, gate, "network unavailable", 1);
+}
+
+function scan_gate_handle_state(ifname, iface, state)
+{
+	let gate = scan_gate_get(ifname, iface);
+	if (!gate)
+		return false;
+
+	if (state == "COMPLETED") {
+		scan_gate_connected(ifname, iface, gate);
+		return true;
+	}
+
+	if (state == "INTERFACE_DISABLED") {
+		scan_gate_remove(ifname);
+		iface_hostapd_notify(ifname, iface, state);
+		return true;
+	}
+
+	if (state == "INACTIVE") {
+		if (gate.phase in [ "parking", "disconnect-retry", "parked" ])
+			return true;
+
+		scan_gate_cancel_timers(gate);
+		gate.phase = "inactive";
+		iface_hostapd_notify(ifname, iface, state);
+		return true;
+	}
+
+	if (gate.phase == "fault") {
+		iface_hostapd_notify(ifname, iface, state);
+		return true;
+	}
+
+	/* DISCONNECT is deliberately reentrant; the settle check owns this phase. */
+	if (gate.phase in [ "parking", "disconnect-retry" ])
+		return true;
+
+	if (gate.phase == "parked") {
+		if (state == "DISCONNECTED")
+			return true;
+
+		if (state == "SCANNING" || scan_gate_is_associating(state))
+			scan_gate_begin_window(ifname, iface, gate);
+	}
+
+	if (state == "SCANNING" || state == "DISCONNECTED") {
+		scan_gate_begin_window(ifname, iface, gate);
+		if (gate.association_started) {
+			gate.association_started = false;
+			scan_gate_defer_park(ifname, iface, gate, "association ended", 1);
+		}
+		return true;
+	}
+
+	if (scan_gate_is_associating(state)) {
+		scan_gate_begin_window(ifname, iface, gate);
+		gate.association_started = true;
+		scan_gate_timer_cancel(gate, "grace");
+		iface_hostapd_notify(ifname, iface, state);
+		return true;
+	}
+
+	iface_hostapd_notify(ifname, iface, state);
+	return true;
+}
