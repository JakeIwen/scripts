+
+function scan_gate_get(ifname, iface)
+{
+	let gate = wpas.data.apsta_scan_gate[ifname];
+	let config = scan_gate_config(ifname);
+	if (!config) {
+		if (gate)
+			scan_gate_remove(ifname);
+		return null;
+	}
+
+	let retry_seconds = int(config.apsta_retry_interval ?? 60);
+	if (retry_seconds < 15)
+		retry_seconds = 15;
+	else if (retry_seconds > 3600)
+		retry_seconds = 3600;
+
+	let timeout_seconds = int(config.apsta_scan_timeout ?? 15);
+	if (timeout_seconds < 5)
+		timeout_seconds = 5;
+	else if (timeout_seconds > 60)
+		timeout_seconds = 60;
+
+	let fallback_frequency = int(config.apsta_fallback_frequency);
+	if (gate && gate.iface == iface &&
+	    gate.retry_ms == retry_seconds * 1000 &&
+	    gate.timeout_ms == timeout_seconds * 1000 &&
+	    gate.fallback_frequency == fallback_frequency)
+		return gate;
+
+	if (gate)
+		scan_gate_remove(ifname);
+
+	gate = {
+		iface,
+		phase: scan_gate_state(iface) == "COMPLETED" ? "connected" : "idle",
+		retry_ms: retry_seconds * 1000,
+		timeout_ms: timeout_seconds * 1000,
+		fallback_frequency,
+		association_started: false,
+		disconnect_attempts: 0,
+		disconnect_ok: false,
