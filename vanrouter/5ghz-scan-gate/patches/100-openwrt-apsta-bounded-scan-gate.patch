+		return false;
+
+	let config = scan_gate_config(ifname);
+	if (config)
+		return true;
+
+	scan_gate_remove(ifname);
+	return false;
+}
+
+scan_gate_state = function(iface)
+{
+	let status = iface.status();
+	return status ? status.state : null;
+};
+
+function scan_gate_is_associating(state)
+{
+	return state in [
+		"AUTHENTICATING", "ASSOCIATING", "ASSOCIATED",
+		"4WAY_HANDSHAKE", "GROUP_HANDSHAKE"
+	];
+}
+
+function scan_gate_is_parkable(state)
+{
+	return state in [ "DISCONNECTED", "INACTIVE", "INTERFACE_DISABLED" ];
+}
+
+function scan_gate_hostapd_set(ifname, gate, up)
+{
+	let phy = wpas.data.iface_phy[ifname];
+	if (!phy) {
+		wpas.printf(`AP/STA scan gate has no PHY for ${ifname}`);
+		return false;
+	}
+
+	let msg = { phy, up };
+	if (up)
+		msg.frequency = gate.fallback_frequency;
+
+	ubus.call("hostapd", "apsta_state", msg);
+	let error = ubus.error();
+	if (error != null) {
+		wpas.printf(`AP/STA scan gate could not ${up ? "start" : "stop"} the AP for ${ifname}: ${error}`);
+		return false;
+	}
+	return true;
+}
+
+function scan_gate_connected(ifname, iface, gate)
+{
+	if (!scan_gate_valid(ifname, iface, gate))
+		return;
+
+	scan_gate_cancel_timers(gate);
+	gate.phase = "connected";
+	gate.association_started = false;
+	gate.disconnect_attempts = 0;
+	gate.disconnect_ok = false;
+	iface_hostapd_notify(ifname, iface, "COMPLETED");
+}
+
+function scan_gate_begin_window(ifname, iface, gate)
+{
+	if (!scan_gate_valid(ifname, iface, gate) || gate.phase == "fault")
+		return false;
+
+	if (gate.phase == "connecting")
+		return true;
+
+	scan_gate_cancel_timers(gate);
+	gate.phase = "connecting";
+	gate.association_started = false;
+	gate.disconnect_attempts = 0;
+	gate.disconnect_ok = false;
