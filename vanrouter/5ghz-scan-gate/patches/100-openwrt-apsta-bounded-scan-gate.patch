+	scan_gate_cancel_timers(gate);
+	gate.disconnect_attempts = 0;
+	gate.disconnect_ok = false;
+	wpas.printf(`AP/STA scan gate parking ${ifname}: ${reason}`);
+	scan_gate_issue_disconnect(ifname, iface, gate);
