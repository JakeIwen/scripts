+		if (!gate.disconnect_ok || !scan_gate_is_parkable(state)) {
+			if (gate.disconnect_attempts < scan_gate_disconnect_limit) {
+				gate.phase = "disconnect-retry";
+				gate.settle = uloop.timer(scan_gate_settle_ms, () => {
+					delete gate.settle;
+					scan_gate_issue_disconnect(ifname, iface, gate);
+				});
+				return;
+			}
