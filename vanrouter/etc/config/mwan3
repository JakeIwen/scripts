
config globals 'globals'
	option mmx_mask '0x3F00'

config interface 'wan'
	option enabled '1'
	list track_ip '1.0.0.1'
	list track_ip '1.1.1.1'
	list track_ip '208.67.222.222'
	list track_ip '208.67.220.220'
	option family 'ipv4'
	option initial_state 'online'
	option track_method 'ping'
	option reliability '1'
	option count '1'
	option size '56'
	option max_ttl '60'
	option failure_interval '3'
	option recovery_interval '3'
	option down '3'
	option interval '3'
	option timeout '3'
	option up '1'
	list flush_conntrack 'ifup'
	list flush_conntrack 'ifdown'
	list flush_conntrack 'connected'
	list flush_conntrack 'disconnected'

config interface 'clientwan'
	option enabled '1'
	list track_ip '1.0.0.1'
	list track_ip '1.1.1.1'
	list track_ip '208.67.222.222'
	list track_ip '208.67.220.220'
	option family 'ipv4'
	option reliability '1'
	option initial_state 'online'
	option track_method 'ping'
	option count '1'
	option size '56'
	option max_ttl '60'
	option interval '3'
	option failure_interval '3'
	option recovery_interval '5'
	option down '3'
	option timeout '3'
	option up '1'
	list flush_conntrack 'ifup'
	list flush_conntrack 'ifdown'
	list flush_conntrack 'connected'
	list flush_conntrack 'disconnected'

config interface 'lifiwan'
	option enabled '1'
	list track_ip '1.0.0.1'
	list track_ip '1.1.1.1'
	list track_ip '208.67.222.222'
	list track_ip '208.67.220.220'
	option family 'ipv4'
	option reliability '1'
	option initial_state 'online'
	option track_method 'ping'
	option count '1'
	option size '56'
	option max_ttl '60'
	option interval '3'
	option failure_interval '5'
	option recovery_interval '3'
	option down '3'
	option timeout '3'
	option keep_failure_interval '1'
	option up '1'
	list flush_conntrack 'ifup'
	list flush_conntrack 'ifdown'
	list flush_conntrack 'connected'
	list flush_conntrack 'disconnected'

config member 'wan_m1_w3'
	option interface 'wan'
	option metric '1'
	option weight '3'

config member 'wan_m2_w3'
	option interface 'wan'
	option metric '2'
	option weight '3'

config member 'clientwan_m1_w2'
	option interface 'clientwan'
	option metric '1'
	option weight '2'

config member 'clientwan_m1_w3'
	option interface 'clientwan'
	option metric '1'
	option weight '3'

config member 'clientwan_m2_w2'
	option interface 'clientwan'
	option metric '2'
	option weight '2'

config member 'lifiwan_m1_w2'
	option interface 'lifiwan'
	option metric '1'
	option weight '2'

config member 'lifiwan_m1_w3'
	option interface 'lifiwan'
	option metric '1'
	option weight '3'

config member 'lifiwan_m2_w2'
	option interface 'lifiwan'
	option metric '2'
	option weight '2'

config policy 'wan_only'
	list use_member 'wan_m1_w3'
	option last_resort 'unreachable'

config policy 'clientwan_only'
	list use_member 'clientwan_m1_w2'
	option last_resort 'unreachable'

config policy 'balanced'
	list use_member 'wan_m1_w3'
	list use_member 'clientwan_m1_w3'
	list use_member 'lifiwan_m1_w3'
	option last_resort 'unreachable'

config rule 'https'
	option sticky '1'
	option dest_port '443'
	option proto 'tcp'
	option use_policy 'balanced'
	option family 'ipv4'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option use_policy 'balanced'
	option family 'ipv4'

config policy 'lifiwan_only'
	option last_resort 'unreachable'
	list use_member 'lifiwan_m1_w3'

