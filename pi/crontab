scripts="/home/pi/scripts"
cronlog="/var/log/cron"
log="/home/pi/log"
tfiles_bkup="/mnt/movingparts/torrent/tfiles_bkup"
PATH="/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin:/root/bin"

0 0 * * *      su pi -c "$scripts/prune_logs.sh $cronlog 1000" >> "$cronlog/prune_cronlogs.log" 2>&1
0 0 * * *      su pi -c "$scripts/prune_logs.sh $log 1000" >> "$cronlog/prune_logs.log" 2>&1
0 13 * * *  "$scripts/rsync_schedule.sh"  >> "$cronlog/rsync.log" 2>&1
* * * * *     su pi -c "$scripts/internet_switches.sh"  >> "$cronlog/internet_switches.log" 2>&1
0 1 * * *      su pi -c "$scripts/prune_logs.sh '/var/log/cron/*.log' >> "$cronlog/prune_logs.log" 2>&1
0 0 * * *      rm -rf $tfiles_bkup/* && cp "/home/pi/tfiles" "$tfiles_bkup" >> "$cronlog/copy_tfiles.log" 2>&1
# * * * * *      su pi -c "$scripts/start_cast.sh"  >> "$cronlog/cast.log" 2>&1
* * * * *      su pi -c "$scripts/log_position.sh"  >> "$cronlog/log_position.sh.log" 2>&1
*/5 * * * *    su pi -c "$scripts/vlc_recent_files_update.sh"  >> "$cronlog/vlc_recent_files_update.log" 2>&1
*/5 * * * *    su pi -c "$scripts/keepalive.sh"  >> "$cronlog/keepalive.log" 2>&1
# 30 9 * * *   su pi -c "$scripts/reboot.sh" >> "$cronlog/reboot.log" 2>&1
# * * * * *    su pi -c "/home/pi/sns.sh standby_grouped" >> "$cronlog/sonos_standby_grouped.log" 2>&1
# * * * * *    su pi -c "$scripts/log_zrate.sh"  >> "$cronlog/log_zrate.log" 2>&1
0 * * * *     su pi -c "$scripts/streetlight.sh"  >> "$cronlog/streetlight.log" 2>&1



