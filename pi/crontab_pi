# restored 2026-07-08 by Claude after accidental `crontab -r` (content verified against session reads)
# cron env: source secrets (NTFY_VOLTAGE_URL, OBD_VIN) via bash BASH_ENV — added 2026-07-09
SHELL=/bin/bash
BASH_ENV=/home/pi/secrets/.bash_variables

0 10-22/2 * * * /home/pi/dev/obd-things/projects/battery/voltage_mon.sh
# Product price alerts; the dashboard's Deal Watch schedule editor sets the times
0 8-23/2 * * * /usr/bin/python3 /home/pi/scripts/price_check/main.py 2>&1 | /usr/bin/logger -t price-check
# Haveno XMR offer alerts every 10 minutes
*/10 * * * * /usr/bin/python3 /home/pi/scripts/price_check/main.py haveno-check 2>&1 | /usr/bin/logger -t price-check
# Van TV: YouTube breaks old yt-dlp releases; refresh it (and Deno) weekly
0 6 * * 0 /bin/bash /home/pi/youtube-cast/current/controller.sh update-ytdlp 2>&1 | /usr/bin/logger -t youtube-cast
# Runs `codex update` once a week; checks every 6 h and defers while Starlink carries the van's traffic.
47 */6 * * * /usr/bin/python3 -I -B /home/pi/scripts/codex_update.py run >> /home/pi/log/codex_update.log 2>&1
# BEGIN managed hosted-project-scan (pi/docs/dashboard/HOSTED_PROJECTS.md)
*/15 * * * * cd /home/pi && PYTHONPATH=/home/pi/scripts/python-packages/current PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -P -m pi.apps.van_dashboard.hosted_project_scan --host pi --post http://127.0.0.1:8788 >> /home/pi/log/hosted_project_scan.log 2>&1
# END managed hosted-project-scan
# Snapshots open Claude/Codex sessions for llmrestore; `llmrestore --cron off` pauses it.
# BEGIN managed llm-restore
* * * * * /bin/mkdir -p -m 700 /home/pi/.local/state/llm-restore && /usr/bin/python3 -I -B /home/pi/scripts/llm_restore.py --snapshot --scheduled >> /home/pi/.local/state/llm-restore/cron.log 2>&1
# END managed llm-restore
