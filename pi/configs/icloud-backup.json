{
  "remote": "icloud:VanRecovery/vanpi/weekly",
  "rclone_config": "/root/.config/rclone/vanpi-icloud.conf",
  "interval_days": 7,
  "keep_generations": 8,
  "max_source_age_hours": 48,
  "guard_interval_seconds": 5,
  "blocked_ssids": ["denlink", "Starlink"],
  "bandwidth_limit": "8M",
  "minimum_free_gib": 100,
  "no_progress_timeout_seconds": 900,
  "local_backup_window_start": "02:55",
  "local_backup_window_end": "09:00"
}
