# Installed as /etc/logrotate.d/rsyslog by pi/sync_scripts.sh (cp_logrotate_conf).
# syslog and auth.log also rotate by size (checked each logrotate run, daily)
# and compress at once: a delayed compress keeps a full uncompressed
# generation on the SD card. The network recorder's spool under
# /run/vanpi-network rotates itself and is not listed here.
/var/log/syslog
/var/log/auth.log
{
	rotate 4
	weekly
	maxsize 50M
	missingok
	notifempty
	compress
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}

/var/log/mail.log
/var/log/kern.log
/var/log/user.log
/var/log/cron.log
{
	rotate 4
	weekly
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}
