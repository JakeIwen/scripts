[Unit]
Description=Vanpi power, USB, kernel event, and resource monitor
After=systemd-journald.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/pi/scripts/system_event_monitor.py --database /var/lib/vanpi-monitor/events.sqlite3 run
Restart=on-failure
RestartSec=5
User=pi
Group=pi
SupplementaryGroups=adm video
StateDirectory=vanpi-monitor
StateDirectoryMode=0750
UMask=0027
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
