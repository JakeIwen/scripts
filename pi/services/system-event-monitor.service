[Unit]
Description=Vanpi power, USB, kernel event, and resource monitor
Wants=vanpi-crash-capture.service
After=systemd-journald.service vanpi-crash-capture.service

[Service]
Type=simple
ExecStartPre=/usr/bin/test -r /home/pi/scripts/system_monitor/__init__.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/system_monitor/common.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/system_monitor/probes.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/system_monitor/journal.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/system_monitor/store.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/system_monitor/rollups.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/system_monitor/daemon.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/system_monitor/crash.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/system_monitor/report.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/system_monitor/cli.py
ExecStart=/usr/bin/python3 /home/pi/scripts/system_event_monitor.py --database /var/lib/vanpi-monitor/events.sqlite3 run
Restart=on-failure
RestartSec=5
User=pi
Group=pi
SupplementaryGroups=adm video
StateDirectory=vanpi-monitor
StateDirectoryMode=0750
UMask=0027
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
