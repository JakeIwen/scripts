[Unit]
Description=Van Dashboard web UI (vehicle, network, media, and price controls on :8788)
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/bin/test -r /home/pi/van_compute/scripts/van_compute_metrics.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/van-dashboard-preview/current/index.html
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_backups.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_block_devices.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_common.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_cop.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_disks.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_home.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_integrations.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_network.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_sonos.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_storage.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_system.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_telemetry.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_usb.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-automation/van_dashboard_vonstar.py
ExecStartPre=/usr/bin/test -x /home/pi/scripts/safe_reboot.sh
ExecStartPre=/usr/bin/test -x /home/pi/scripts/safe_power_down.sh
ExecStart=/usr/bin/python3 /home/pi/scripts/python-automation/van_dashboard.py
ExecStopPost=/usr/bin/python3 /home/pi/scripts/python-automation/van_dashboard_cop.py --relay-off
WorkingDirectory=/home/pi
Restart=always
RestartSec=5
User=pi
SupplementaryGroups=gpio
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/pi/van_compute/scripts
Environment=VAN_DASHBOARD_FRONTEND_ROOT=/home/pi/scripts/van-dashboard-preview/current
# Native Time Machine creation selected this name during the 64 MiB migration.
Environment=VAN_DASHBOARD_TIME_MACHINE_BUNDLE=/mnt/mbp2tbkup/m4mac0.sparsebundle
RuntimeDirectory=van-dashboard
RuntimeDirectoryMode=0750
UMask=0027

[Install]
WantedBy=multi-user.target
