[Unit]
Description=Van Dashboard web UI (vehicle, network, media, and price controls on :8788)
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/bin/test -r /home/pi/van_compute/current/van_compute/metrics.py
ExecStartPre=/usr/bin/test -r /home/pi/scripts/van-dashboard-preview/current/index.html
ExecStartPre=/usr/bin/test -r /home/pi/scripts/python-packages/current/manifest.json
ExecStartPre=/usr/bin/test -x /home/pi/scripts/safe_reboot.sh
ExecStartPre=/usr/bin/test -x /home/pi/scripts/safe_power_down.sh
ExecStart=/usr/bin/python3 -P -m pi.apps.van_dashboard
ExecStopPost=/usr/bin/python3 -P -m pi.apps.van_dashboard.van_dashboard_cop --relay-off
WorkingDirectory=/home/pi
Restart=always
RestartSec=5
User=pi
SupplementaryGroups=gpio
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/pi/scripts/python-packages/current:/home/pi/van_compute/current
Environment=VAN_DASHBOARD_FRONTEND_ROOT=/home/pi/scripts/van-dashboard-preview/current
# Native Time Machine creation selected this name during the 64 MiB migration.
Environment=VAN_DASHBOARD_TIME_MACHINE_BUNDLE=/mnt/mbp2tbkup/m4mac0.sparsebundle
RuntimeDirectory=van-dashboard
RuntimeDirectoryMode=0750
UMask=0027

[Install]
WantedBy=multi-user.target
