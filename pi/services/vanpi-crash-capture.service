[Unit]
Description=Capture vanpi evidence from the preceding boot
Wants=systemd-journal-flush.service
After=local-fs.target systemd-journal-flush.service systemd-pstore.service
Before=system-event-monitor.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/pi/scripts/system_event_monitor.py --database /var/lib/vanpi-monitor/events.sqlite3 boot-capture --output-directory /var/lib/vanpi-monitor/crash-reports
User=pi
Group=pi
SupplementaryGroups=adm video
StateDirectory=vanpi-monitor
StateDirectoryMode=0750
UMask=0027
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=90
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
