{
  "required": ["user-agent", "cookie"],
  "optional": [
    "accept", "accept-encoding", "accept-language", "cache-control", "pragma",
    "priority", "referer", "dnt", "sec-gpc", "upgrade-insecure-requests",
    "sec-ch-ua", "sec-ch-ua-full-version", "sec-ch-ua-full-version-list",
    "sec-ch-ua-mobile", "sec-ch-ua-model", "sec-ch-ua-platform",
    "sec-ch-ua-platform-version", "sec-ch-ua-arch", "sec-ch-ua-bitness",
    "sec-fetch-dest", "sec-fetch-mode", "sec-fetch-site", "sec-fetch-user"
  ]
}
