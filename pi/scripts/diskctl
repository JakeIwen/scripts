#!/bin/bash
# Safe, label-only manual disk controls for the van dashboard.
set -u

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=disk_policy.sh
. "$script_dir/disk_policy.sh" || exit 1

unmount_disks=${DISKCTL_UNMOUNT_DISKS:-/home/pi/scripts/umount_disks.sh}
mount_disks=${DISKCTL_MOUNT_DISKS:-/home/pi/scripts/mount_disks.sh}
internet_switches=${DISKCTL_INTERNET_SWITCHES:-/home/pi/scripts/internet_switches.sh}
policyctl=${DISKCTL_POLICYCTL:-/home/pi/scripts/policyctl}
sudo_command=${DISKCTL_SUDO:-/usr/bin/sudo}
blkid_command=${DISKCTL_BLKID:-/sbin/blkid}
findmnt_command=${DISKCTL_FINDMNT:-/usr/bin/findmnt}
readlink_command=${DISKCTL_READLINK:-/usr/bin/readlink}
lsblk_command=${DISKCTL_LSBLK:-/usr/bin/lsblk}
fsck_exfat_command=${DISKCTL_FSCK_EXFAT:-/usr/sbin/fsck.exfat}
fsck_ext4_command=${DISKCTL_FSCK_EXT4:-/usr/sbin/e2fsck}
python_command=${DISKCTL_PYTHON:-/usr/bin/python3}
install_command=${DISKCTL_INSTALL:-/usr/bin/install}
rm_command=${DISKCTL_RM:-/usr/bin/rm}
touch_command=${DISKCTL_TOUCH:-/usr/bin/touch}
timeout_command=${DISKCTL_TIMEOUT:-/usr/bin/timeout}
date_command=${DISKCTL_DATE:-/usr/bin/date}
mktemp_command=${DISKCTL_MKTEMP:-/usr/bin/mktemp}
mount_root=${DISKCTL_MOUNT_ROOT:-/mnt}
require_block_device=${DISKCTL_REQUIRE_BLOCK_DEVICE:-1}
ignition_flag=${DISKCTL_IGNITION_FLAG:-/home/pi/hooks/ignition_is_on}
lifecycle_lock=${DISKCTL_LIFECYCLE_LOCK:-/home/pi/.internet_switches.lock}
flock_command=${DISKCTL_FLOCK:-/usr/bin/flock}
hold_seconds=60

# disk_policy's resolver discovers from udev links and verifies only the exact
# selected device. Keep diskctl's injectable commands wired into that helper.
DISK_POLICY_BY_LABEL_DIR=${DISKCTL_BY_LABEL_DIR:-/dev/disk/by-label}
DISK_POLICY_READLINK=$readlink_command
DISK_POLICY_BLKID=$blkid_command
DISK_POLICY_SUDO=$sudo_command
DISK_POLICY_UDEVADM=${DISKCTL_UDEVADM:-/usr/bin/udevadm}
DISK_POLICY_SYS_BLOCK_DIR=${DISKCTL_SYS_BLOCK_DIR:-/sys/class/block}
DISK_POLICY_REQUIRE_BLOCK_DEVICE=$require_block_device

[[ "$require_block_device" == 0 || "$require_block_device" == 1 ]] || {
  echo "diskctl: invalid block-device requirement" >&2
  exit 2
}

usage() {
  echo "usage: diskctl eject|mount|repair <managed-label>" >&2
}

print_check_output() {
  local output=$1 line
  [[ -n "$output" ]] || return 0
  while IFS= read -r line; do
    printf '  %s\n' "$line"
  done <<< "$output"
}

action=${1:-}
label=${2:-}
[[ $# == 2 &&
   ( "$action" == eject || "$action" == mount || "$action" == repair ) ]] || {
  usage
  exit 2
}
disk_policy_is_control_label "$label" || {
  echo "diskctl: unknown managed disk label" >&2
  exit 2
}

health_state_file="$DISK_HEALTH_STATE_DIR/$label.json"
health_quarantine=$(disk_health_quarantine_marker "$label") || exit 1

write_health_state() {
  local state=$1 message=$2 checked_at tmp
  checked_at=$("$date_command" +%s) || return 1
  tmp=$("$mktemp_command" "/tmp/vanpi-disk-health.$label.XXXXXX") || return 1
  if ! "$python_command" - "$label" "$state" "$message" "$checked_at" > "$tmp" <<'PY'
import json
import sys

label, state, message, checked_at = sys.argv[1:]
json.dump(
    {
        "version": 1,
        "label": label,
        "state": state,
        "message": message,
        "checked_at": int(checked_at),
    },
    sys.stdout,
    sort_keys=True,
)
sys.stdout.write("\n")
PY
  then
    "$rm_command" -f -- "$tmp"
    return 1
  fi
  "$sudo_command" "$install_command" -d -m 0755 -o root -g root \
    -- "$DISK_HEALTH_STATE_DIR" || {
      "$rm_command" -f -- "$tmp"
      return 1
    }
  "$sudo_command" "$install_command" -m 0644 -o root -g root \
    -- "$tmp" "$health_state_file"
  status=$?
  "$rm_command" -f -- "$tmp"
  return "$status"
}

set_health_quarantine() {
  "$sudo_command" "$install_command" -d -m 0755 -o root -g root \
    -- "$DISK_HEALTH_STATE_DIR/quarantine" &&
    "$sudo_command" "$install_command" -m 0644 -o root -g root \
      -- /dev/null "$health_quarantine"
}

clear_health_quarantine() {
  "$sudo_command" "$rm_command" -f -- "$health_quarantine"
}

resolve_exact_filesystem() {
  local actual_type parent_rows name type extra transport
  local -a parents=()

  disk_policy_resolve_exact_label "$label" label-only
  status=$?
  if (( status != 0 )); then
    echo "diskctl: cannot resolve exact label $label: ${DISK_POLICY_RESOLVE_ERROR:-no udev label mapping}" >&2
    return 1
  fi
  device=$DISK_POLICY_RESOLVED_DEVICE
  actual_type=$("$sudo_command" "$blkid_command" -s TYPE -o value -- "$device") ||
    return 1
  case "$actual_type" in
    exfat|ext4) filesystem=$actual_type ;;
    *)
      echo "diskctl: automatic repair does not support $actual_type ($label)" >&2
      return 1
      ;;
  esac

  parent_rows=$("$lsblk_command" -s -nrpo NAME,TYPE -- "$device") || return 1
  while read -r name type extra; do
    [[ -z ${extra:-} ]] || return 1
    [[ "$type" == disk ]] && parents+=("$name")
  done <<< "$parent_rows"
  (( ${#parents[@]} == 1 )) || return 1
  parent=${parents[0]}
  transport=$("$lsblk_command" -dnro TRAN -- "$parent") || return 1
  [[ "$transport" == usb ]] || {
    echo "diskctl: refusing repair on non-USB parent $parent" >&2
    return 1
  }
}

case "$action" in
  eject)
    # Auto-mounted labels need a temporary hold. Manual-only labels such as
    # bigboi stay unmounted without one.
    if disk_policy_is_mount_label "$label"; then
      # Install the hold before waiting on the lifecycle lock. A reconciliation
      # already in progress may finish, but the subsequent unmount wins and no
      # later automatic pass can remount this label during the hold.
      disk_eject_hold_set "$label" "$hold_seconds" >/dev/null || exit 1
    fi
    exec 9>"$lifecycle_lock" || exit 1
    "$flock_command" -w 55 9 || {
      if disk_policy_is_mount_label "$label"; then
        echo "diskctl: disk policy is busy; eject hold remains active" >&2
      else
        echo "diskctl: disk policy is busy" >&2
      fi
      exit 1
    }
    "$unmount_disks" "$label"
    ;;
  mount)
    if disk_policy_is_always_mount_label "$label"; then
      # Always-available flash media is independent of ignition and requested
      # HDD policy. Serialize it with the same lifecycle lock, then clear the
      # temporary eject hold only when the explicit remount can proceed.
      exec 9>"$lifecycle_lock" || exit 1
      "$flock_command" -w 55 9 || {
        echo "diskctl: disk policy is busy; eject hold remains active" >&2
        exit 1
      }
      disk_eject_hold_clear "$label" || exit 1
      "$mount_disks" "$label"
      exit $?
    fi

    policy=$($policyctl read 2>&1)
    status=$?
    if (( status != 0 )); then
      echo "diskctl: cannot read disk policy: $policy" >&2
      exit 1
    fi
    read -r disks_enabled torrents_enabled starlink_torrents extra <<< "$policy"
    if [[ "$disks_enabled" != 1 || ! "$torrents_enabled" =~ ^[01]$ ||
          ! "$starlink_torrents" =~ ^[01]$ || -n ${extra:-} ]]; then
      echo "diskctl: disks must be enabled in requested policy before mounting" >&2
      exit 1
    fi
    if [[ -e "$ignition_flag" ]]; then
      echo "diskctl: ignition is on; disk policy will not mount USB storage" >&2
      exit 1
    fi
    if disk_policy_is_mount_label "$label"; then
      # Keep an existing hold intact when policy or ignition prevents the
      # mount. It is cleared only once this request is eligible for
      # reconciliation.
      disk_eject_hold_clear "$label" || exit 1
      # Reconcile synchronously so the dashboard operation completes only
      # after the existing policy and mount safeguards have run.
      "$internet_switches"
    else
      # Manual-only disks must not invoke full reconciliation, which excludes
      # them by design. Serialize the exact-label mount with other lifecycle
      # work and retain mount_disks.sh's discovery and target safeguards.
      exec 9>"$lifecycle_lock" || exit 1
      "$flock_command" -w 55 9 || {
        echo "diskctl: disk policy is busy" >&2
        exit 1
      }
      "$mount_disks" "$label"
    fi
    ;;
  repair)
    [[ ! -e "$ignition_flag" ]] || {
      echo "diskctl: ignition is on; refusing filesystem repair" >&2
      exit 1
    }
    device=
    filesystem=
    parent=
    resolve_exact_filesystem || exit 1
    original_device=$device
    original_filesystem=$filesystem
    original_parent=$parent
    case "$filesystem" in
      exfat)
        fsck_command=$fsck_exfat_command
        filesystem_name=exFAT
        ;;
      ext4)
        fsck_command=$fsck_ext4_command
        filesystem_name=ext4
        ;;
    esac
    [[ -x "$fsck_command" ]] || {
      echo "diskctl: $fsck_command is unavailable" >&2
      exit 1
    }

    if disk_policy_is_mount_label "$label"; then
      disk_eject_hold_set "$label" 300 >/dev/null || exit 1
    fi
    exec 9>"$lifecycle_lock" || exit 1
    "$flock_command" -w 55 9 || {
      echo "diskctl: disk policy is busy; repair hold remains active" >&2
      exit 1
    }
    [[ ! -e "$ignition_flag" ]] || {
      echo "diskctl: ignition turned on before repair started" >&2
      exit 1
    }
    resolve_exact_filesystem || exit 1
    if [[ "$device" != "$original_device" ||
          "$filesystem" != "$original_filesystem" ||
          "$parent" != "$original_parent" ]]; then
      echo "diskctl: device identity changed before $label repair started" >&2
      exit 1
    fi
    target="$mount_root/$label"
    mounted=$("$findmnt_command" -rn -M "$target" -o SOURCE 2>&1)
    status=$?
    if (( status == 0 )) && [[ -n "$mounted" && "$mounted" != *$'\n'* ]]; then
      resolved_mounted=$("$readlink_command" -f -- "$mounted") || exit 1
      [[ "$resolved_mounted" == "$device" ]] || {
        echo "diskctl: $target is mounted from $resolved_mounted, not $device" >&2
        exit 1
      }
      was_mounted=1
    elif (( status == 1 )) && [[ -z "$mounted" ]]; then
      was_mounted=0
    else
      echo "diskctl: cannot determine the pre-repair mount state for $label" >&2
      exit 1
    fi
    set_health_quarantine || exit 1
    write_health_state checking "$filesystem_name filesystem repair is running" || exit 1

    if ! "$unmount_disks" "$label"; then
      write_health_state critical "Could not safely unmount the filesystem for repair" || true
      echo "diskctl: could not safely unmount $label for repair" >&2
      exit 1
    fi
    resolve_exact_filesystem || {
      write_health_state critical "Exact filesystem device verification failed after unmount" || true
      exit 1
    }
    if [[ "$device" != "$original_device" ||
          "$filesystem" != "$original_filesystem" ||
          "$parent" != "$original_parent" ]]; then
      write_health_state critical "USB device identity changed during filesystem repair" || true
      echo "diskctl: device identity changed while preparing $label for repair" >&2
      exit 1
    fi
    mounted=$("$findmnt_command" -rn -S "$device" -o TARGET 2>&1)
    status=$?
    if (( status == 0 )) || (( status != 1 )) || [[ -n "$mounted" ]]; then
      write_health_state critical "Filesystem remained mounted or could not be verified before repair" || true
      echo "diskctl: refusing fsck because $device is not verifiably unmounted" >&2
      exit 1
    fi

    if [[ "$filesystem" == exfat ]]; then
      repair_output=$(
        "$sudo_command" "$fsck_command" -p -- "$device" 2>&1
      )
    else
      repair_output=$(
        "$sudo_command" "$fsck_command" -pf -- "$device" 2>&1
      )
    fi
    repair_status=$?
    if [[ "$filesystem" == exfat ]]; then
      repair_status_ok=$((repair_status == 0 || repair_status == 1))
    else
      # e2fsck status 2 explicitly requests a system reboot. Leave that case
      # quarantined and unmounted instead of treating it as safe to restore.
      repair_status_ok=$((repair_status == 0 || repair_status == 1))
    fi
    if (( ! repair_status_ok )); then
      if [[ "$filesystem" == ext4 && "$repair_status" == 2 ]]; then
        write_health_state warning \
          "ext4 repair corrected errors but requested a reboot; filesystem remains quarantined and unmounted" || true
      else
        write_health_state critical \
          "Automatic $filesystem_name repair failed (status $repair_status): ${repair_output: -300}" || true
      fi
      echo "diskctl: $filesystem_name repair failed (status $repair_status): $repair_output" >&2
      exit 1
    fi
    if (( repair_status == 0 )); then
      repair_summary="$filesystem_name needed no repairs"
    else
      repair_summary="$filesystem_name errors were repaired"
    fi
    echo "$label: automatic check complete; $repair_summary (status $repair_status)"
    print_check_output "$repair_output"

    if [[ "$filesystem" == exfat ]]; then
      verify_output=$(
        "$sudo_command" "$fsck_command" -n -- "$device" 2>&1
      )
    else
      verify_output=$(
        "$sudo_command" "$fsck_command" -fn -- "$device" 2>&1
      )
    fi
    verify_status=$?
    if (( verify_status != 0 )); then
      write_health_state critical \
        "$filesystem_name remained inconsistent after repair (status $verify_status): ${verify_output: -300}" || true
      echo "diskctl: $filesystem_name verification failed: $verify_output" >&2
      exit 1
    fi
    echo "$label: read-only $filesystem_name verification passed"
    print_check_output "$verify_output"

    clear_health_quarantine || exit 1
    if disk_policy_is_mount_label "$label"; then
      disk_eject_hold_clear "$label" || exit 1
    fi
    if (( ! was_mounted )); then
      health_message="$repair_summary; verification passed; preserved unmounted state"
      write_health_state healthy "$health_message" || exit 1
      echo "$label: healthy: $health_message"
      exit $?
    fi

    [[ ! -e "$ignition_flag" ]] || {
      write_health_state warning \
        "$repair_summary; verification passed; left unmounted because ignition turned on" || true
      echo "diskctl: ignition turned on; repaired filesystem remains unmounted" >&2
      exit 1
    }
    if disk_policy_is_mount_label "$label" &&
       ! disk_policy_is_always_mount_label "$label"; then
      policy=$("$policyctl" read 2>&1)
      status=$?
      read -r disks_enabled torrents_enabled starlink_torrents extra <<< "$policy"
      if (( status != 0 )) ||
         [[ ! "$disks_enabled" =~ ^[01]$ ||
            ! "$torrents_enabled" =~ ^[01]$ ||
            ! "$starlink_torrents" =~ ^[01]$ || -n ${extra:-} ]]; then
        write_health_state warning \
          "$repair_summary; verification passed; requested disk policy could not be verified" || true
        echo "diskctl: repaired $label but could not verify requested disk policy" >&2
        exit 1
      fi
      if [[ "$disks_enabled" != 1 ]]; then
        health_message="$repair_summary; verification passed; left unmounted by requested policy"
        write_health_state healthy "$health_message" || exit 1
        echo "$label: healthy: $health_message"
        exit $?
      fi
    fi
    "$mount_disks" "$label" || {
      write_health_state warning \
        "$repair_summary; verification passed; remount failed" || true
      exit 1
    }
    mounted=$("$findmnt_command" -rn -M "$target" -o SOURCE 2>&1)
    status=$?
    resolved_mounted=$("$readlink_command" -f -- "$mounted" 2>/dev/null) || true
    if (( status != 0 )) || [[ "$resolved_mounted" != "$device" ]]; then
      write_health_state warning \
        "$repair_summary; verification passed; exact remount verification failed" || true
      exit 1
    fi
    probe="$target/.vanpi_health_probe.$$"
    if ! "$timeout_command" 10 "$touch_command" "$probe" ||
       ! "$rm_command" -f -- "$probe"; then
      write_health_state critical \
        "$repair_summary; verification passed; remounted, but pi cannot write to it" || true
      echo "diskctl: repaired mount is not writable by pi" >&2
      exit 1
    fi
    health_message="$repair_summary; verification passed; remounted read/write and write probe passed"
    write_health_state healthy "$health_message" || exit 1
    echo "$label: healthy: $health_message"
    if disk_policy_is_mount_label "$label" &&
       ! disk_policy_is_always_mount_label "$label"; then
      exec 9>&-
      "$internet_switches" || {
        echo "WARNING: $label was repaired but policy reconciliation failed" >&2
      }
    fi
    ;;
esac
