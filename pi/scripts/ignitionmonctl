#!/bin/bash

# Manage the durable ignition-monitor override used by ignition_monitor.sh.
# The deadline is an absolute Unix timestamp so time spent powered off counts.

inactive=${IGNITIONMON_INACTIVE_FILE:-"$HOME/hooks/inactive/ignition"}
lock=${inactive}.lock
flock_command=${IGNITIONMON_FLOCK:-/usr/bin/flock}
max_seconds=$((366 * 24 * 60 * 60))
output_json=false

usage() {
  cat >&2 <<'EOF'
usage:
  ignitionmonctl disable <duration>
  ignitionmonctl enable
  ignitionmonctl status [--json]

Durations may be written as 30, 30m, 2h, "30 minutes", or "2 hours".
A bare number means minutes. The maximum duration is 366 days.
EOF
}

now_epoch() {
  if [[ -n ${IGNITIONMON_NOW:-} ]]; then
    printf '%s\n' "$IGNITIONMON_NOW"
  else
    date +%s
  fi
}

format_duration() {
  local total=$1 days hours minutes seconds result=
  days=$((total / 86400))
  hours=$(((total % 86400) / 3600))
  minutes=$(((total % 3600) / 60))
  seconds=$((total % 60))
  ((days == 0)) || result+="${days}d "
  ((hours == 0)) || result+="${hours}h "
  ((minutes == 0)) || result+="${minutes}m "
  ((seconds == 0)) || result+="${seconds}s"
  printf '%s\n' "${result% }"
}

parse_duration() {
  local amount unit multiplier
  case $# in
    1)
      case $1 in
        *[mM]) amount=${1%?}; unit=m ;;
        *[hH]) amount=${1%?}; unit=h ;;
        *) amount=$1; unit=m ;;
      esac
      ;;
    2)
      amount=$1
      case $2 in
        m|M|min|Min|mins|Mins|minute|Minute|minutes|Minutes) unit=m ;;
        h|H|hr|Hr|hrs|Hrs|hour|Hour|hours|Hours) unit=h ;;
        *) return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac

  [[ $amount =~ ^[0-9]+$ ]] || return 1
  amount=$((10#$amount))
  ((amount > 0)) || return 1
  [[ $unit == h ]] && multiplier=3600 || multiplier=60
  ((amount <= max_seconds / multiplier)) || return 2
  PARSED_SECONDS=$((amount * multiplier))
}

ensure_state_dir() {
  local state_dir=${inactive%/*}
  [[ $state_dir != "$inactive" ]] || state_dir=.
  mkdir -p -- "$state_dir"
}

lock_state() {
  ensure_state_dir || return 1
  exec 9>"$lock" || return 1
  "$flock_command" -x 9
}

read_deadline() {
  DEADLINE=
  [[ -f $inactive ]] || return 1
  IFS= read -r DEADLINE < "$inactive" || true
  # Bound arithmetic input so a corrupt file cannot wrap and become permanent.
  [[ $DEADLINE =~ ^[1-9][0-9]{0,10}$ ]]
}

remove_invalid_or_expired_state() {
  local now=$1 reason=$2
  rm -f -- "$inactive" || return 1
  $output_json && return 0
  if [[ $reason == expired ]]; then
    printf 'ignition monitor override expired at %s; monitor reactivated at %s\n' \
      "$DEADLINE" "$now"
  else
    printf 'ignition monitor override was malformed; monitor reactivated at %s\n' \
      "$now" >&2
  fi
}

check_disabled_locked() {
  local now=$1
  [[ -e $inactive ]] || return 1
  if ! read_deadline; then
    remove_invalid_or_expired_state "$now" malformed || return 2
    return 1
  fi
  if ((now >= DEADLINE)); then
    remove_invalid_or_expired_state "$now" expired || return 2
    return 1
  fi
  return 0
}

disable_monitor() {
  local now deadline temporary display
  parse_duration "$@"
  case $? in
    0) ;;
    2) printf 'ignitionmonctl: duration must not exceed 366 days\n' >&2; return 2 ;;
    *) usage; return 2 ;;
  esac

  now=$(now_epoch) || return 1
  [[ $now =~ ^[1-9][0-9]{0,10}$ ]] || {
    printf 'ignitionmonctl: system clock did not return a valid timestamp\n' >&2
    return 1
  }
  deadline=$((now + PARSED_SECONDS))
  ((deadline > now)) || {
    printf 'ignitionmonctl: deadline overflowed\n' >&2
    return 1
  }

  lock_state || return 1
  temporary=$(mktemp "${inactive}.tmp.XXXXXX") || return 1
  if ! printf '%s\n' "$deadline" > "$temporary" ||
     ! mv -f -- "$temporary" "$inactive"; then
    rm -f -- "$temporary"
    return 1
  fi
  # Make an immediately-following power loss less likely to lose the deadline.
  sync -f "$inactive" 2>/dev/null || sync

  display=$(date --date="@$deadline" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null) ||
    display="Unix time $deadline"
  printf 'ignition monitor disabled for %s (until %s)\n' \
    "$(format_duration "$PARSED_SECONDS")" "$display"
}

enable_monitor() {
  lock_state || return 1
  if [[ -e $inactive ]]; then
    rm -f -- "$inactive" || return 1
    printf 'ignition monitor reactivated\n'
  else
    printf 'ignition monitor is already active\n'
  fi
}

status_monitor() {
  local now remaining display status
  if [[ ${1:-} == --json ]]; then
    output_json=true
    shift
  fi
  [[ $# == 0 ]] || { usage; return 2; }
  now=$(now_epoch) || return 1
  [[ $now =~ ^[1-9][0-9]{0,10}$ ]] || return 1
  lock_state || return 1
  check_disabled_locked "$now"
  status=$?
  if ((status == 0)); then
    remaining=$((DEADLINE - now))
    if $output_json; then
      printf '{"version":1,"status":"disabled","active":false,"deadline":%s,"remaining_seconds":%s,"checked_at":%s}\n' \
        "$DEADLINE" "$remaining" "$now"
      return 0
    fi
    display=$(date --date="@$DEADLINE" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null) ||
      display="Unix time $DEADLINE"
    printf 'disabled: %s remaining (until %s)\n' \
      "$(format_duration "$remaining")" "$display"
    return 0
  fi
  case $status in
    1)
      if $output_json; then
        printf '{"version":1,"status":"active","active":true,"deadline":null,"remaining_seconds":0,"checked_at":%s}\n' "$now"
      else
        printf 'active\n'
      fi
      return 0
      ;;
    *) return 1 ;;
  esac
}

check_monitor() {
  local now status
  now=$(now_epoch) || return 2
  [[ $now =~ ^[1-9][0-9]{0,10}$ ]] || return 2
  lock_state || return 2
  check_disabled_locked "$now"
  status=$?
  case $status in
    0) return 0 ;;
    1) return 1 ;;
    *) return 2 ;;
  esac
}

case ${1:-} in
  disable)
    shift
    disable_monitor "$@"
    ;;
  enable)
    shift
    [[ $# == 0 ]] || { usage; exit 2; }
    enable_monitor
    ;;
  status)
    shift
    status_monitor "$@"
    ;;
  check)
    shift
    [[ $# == 0 ]] || exit 2
    check_monitor
    ;;
  *)
    usage
    exit 2
    ;;
esac
