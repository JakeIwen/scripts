#!/bin/sh
# Checkout launch boundary: retain the caller's cwd and environment for Codex;
# -I keeps modules in that cwd (a stray pty.py, select.py) from shadowing the stdlib.
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd) || exit 1

# The wrapper is the tty's foreground job, so iTerm labels the tab with its
# process name. Running Python through a symlink named codex-retry shows
# "(codex-retry)" instead of "(Python)"; the exact name "codex" would make
# llm_restore count the wrapper as a Codex TUI. macOS framework Pythons
# re-exec Python.app, so the link targets that binary when it exists.
python=/usr/bin/python3
link="${XDG_STATE_HOME:-$HOME/.local/state}/codex-autocontinue/codex-retry"
if [ ! -x "$link" ]; then
  target=$("$python" -I -c '
import os, sys
app = os.path.join(sys.base_prefix, "Resources/Python.app/Contents/MacOS/Python")
print(app if os.access(app, os.X_OK) else os.path.realpath(sys.executable))
') && mkdir -p "$(dirname -- "$link")" && ln -sf "$target" "$link"
fi
[ -x "$link" ] && python=$link

exec "$python" -I -c '
import runpy, sys
sys.path.insert(0, sys.argv.pop(1))
runpy.run_module("shared.codex_autocontinue", run_name="__main__")
' "$root" "$@"
