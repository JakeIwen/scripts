<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.jacobr.deal-watch-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/jacobr/dev/scripts/macbook/scripts/deal_watch_refresh.py</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/jacobr/dev/scripts</string>
    <key>RunAtLoad</key><true/>
    <key>StartInterval</key><integer>300</integer>
    <key>ProcessType</key><string>Background</string>
    <key>Umask</key><integer>63</integer>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>/usr/bin:/bin</string></dict>
    <key>StandardOutPath</key>
    <string>/Users/jacobr/dev/scripts/tmp/deal-watch-refresh/worker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jacobr/dev/scripts/tmp/deal-watch-refresh/worker.log</string>
</dict>
</plist>
