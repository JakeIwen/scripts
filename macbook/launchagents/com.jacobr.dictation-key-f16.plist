<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.jacobr.dictation-key-f16</string>
    <!-- hidutil mappings are lost at logout and restart, so this reapplies the
         mapping at each login. 0xC000000CF is the F5 dictation (microphone) key,
         HID consumer page 0x0C usage 0xCF; 0x70000006B is F16. Not F13–F15:
         Firefox on macOS reads those as PrintScreen, ScrollLock and Pause, so
         its shortcuts never see them. Setting
         UserKeyMapping replaces the whole list: add any other remap here too. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/hidutil</string>
        <string>property</string>
        <string>--set</string>
        <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0xC000000CF,"HIDKeyboardModifierMappingDst":0x70000006B}]}</string>
    </array>
    <key>RunAtLoad</key><true/>
</dict>
</plist>
