# Linux test lane pins: the one place its image and tool versions are recorded.
# Sourced by provision.sh inside the VM and parsed by pins.py on the Mac, so keep
# plain KEY=value lines (no quotes, spaces or shell expansion).
#
# Versions match vanpi as verified live (read-only) on 2026-11-04: Debian 12
# bookworm aarch64, /usr/bin/python3 3.11.2, bash 5.2.15, borg 1.2.4 (apt),
# rclone v1.75.1 at /usr/local/bin, node v20.20.0. restic is pinned (version and
# both hashes) by pi/scripts/backup/install_restic.sh, which provisioning runs
# unchanged, so it is deliberately not repeated here.

# Debian's dated bookworm genericcloud build, as pinned by Lima 2.2.1's template.
DEBIAN_IMAGE_URL=https://cloud.debian.org/images/cloud/bookworm/20260923-2610/debian-12-genericcloud-arm64-20260923-2610.qcow2
DEBIAN_IMAGE_DIGEST=sha512:89a752d5c7d8e88bee39a57d88d496cca574f7d1e8df5df7a169825435f99feb11ed13ab27ec7bee96fe1584be4ff9479358fbca6cc859efa109f4aba18724c8

# Apt packages come from the live bookworm archive; provisioning fails instead of
# testing against a version the Pi does not run.
EXPECT_PYTHON=3.11.2
EXPECT_BASH=5.2.15
EXPECT_BORG=1.2.4

# Source: https://nodejs.org/dist/v20.20.0/SHASUMS256.txt
NODE_VERSION=20.20.0
NODE_SHA256=752113754a7dddf0622b3740a2b2bec3dbaf1792a18711b55871d76444d8892a

# Source: https://downloads.rclone.org/v1.75.1/SHA256SUMS
RCLONE_VERSION=1.75.1
RCLONE_SHA256=03f2504174034b6d004152ed7369251c9a9ec1f7e0836eda420f5c7a5ec0dff9

# The VM mirrors the Pi's login so scripts that assume pi/1000 see the same user.
LANE_USER=pi
LANE_UID=1000
VM_CPUS=8
VM_MEMORY=8GiB
VM_DISK=40GiB
